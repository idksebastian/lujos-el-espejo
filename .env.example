VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dominio interno inventado usado para construir el correo ficticio
# a partir del nombre de usuario (nombre.apellido -> nombre.apellido@dominio)
VITE_AUTH_FAKE_DOMAIN=lujosdeauto.local

# Google Analytics 4 (sitio público). Opcional: si está vacío, no se carga
# Analytics y la app funciona igual. Formato: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# --- Solo para scripts locales (NUNCA con prefijo VITE_, nunca en el frontend) ---
# Usadas por scripts/crear-primer-admin.mjs. La service_role key se obtiene en
# Supabase Dashboard > Project Settings > API. No la subas a git ni la pegues
# en el codigo del frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_FAKE_DOMAIN=lujosdeauto.local
